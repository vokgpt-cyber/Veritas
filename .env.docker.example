# Copy to .env.docker or run START_VERITAS_DOCKER.bat to generate it.

EPAM_BACKEND_PORT=8765
EPAM_FRONTEND_PORT=5173

# Generate real values for pilot/production. The Docker launcher creates
# random values automatically when .env.docker is missing.
EPAM_AUTH_SECRET_KEY=CHANGE_ME_generate_random_secret
EPAM_ENCRYPTION_SECRET_KEY=CHANGE_ME_generate_random_secret

# Ollama is expected to run on the Windows host.
EPAM_SUMMARIZATION_OLLAMA_BASE_URL=http://host.docker.internal:11434
EPAM_SUMMARIZATION_OLLAMA_MODEL=gemma4:26b

# Required for first-time download of pyannote/speaker-diarization-community-1.
# Create a Hugging Face read token after accepting the model conditions.
HF_TOKEN=

# Privacy: keep pyannote anonymous telemetry disabled in the law-firm setup.
PYANNOTE_METRICS_ENABLED=0

# Set to 1 only after model caches are already populated inside Docker volumes.
HF_HUB_OFFLINE=0
TRANSFORMERS_OFFLINE=0
HF_DATASETS_OFFLINE=0

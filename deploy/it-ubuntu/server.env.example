# Copy to .env.server in this folder before the first server run.
# START_VERITAS_UBUNTU.sh can create .env.server automatically.

VERITAS_IMAGE_TAG=1.0

# Server ports.
# Frontend is the user-facing web UI. Backend should normally stay local-only.
EPAM_FRONTEND_BIND=127.0.0.1
EPAM_FRONTEND_PORT=5173
EPAM_BACKEND_BIND=127.0.0.1
EPAM_BACKEND_PORT=8765

# Generate real random values for pilot/production.
EPAM_AUTH_SECRET_KEY=CHANGE_ME_generate_random_secret
EPAM_AUTH_DEFAULT_PASSWORD_HASH=
EPAM_AUTH_DEFAULT_PASSWORD=
EPAM_ENCRYPTION_SECRET_KEY=CHANGE_ME_generate_random_secret

# Hugging Face token is required for first pyannote download.
# The account must have accepted pyannote/speaker-diarization-community-1.
HF_TOKEN=
PYANNOTE_METRICS_ENABLED=0

# Offline mode: keep 0 for first model download, switch to 1 after caches exist.
HF_HUB_OFFLINE=0
TRANSFORMERS_OFFLINE=0
HF_DATASETS_OFFLINE=0

# GPU selection. For a single RTX 4090 keep CUDA_VISIBLE_DEVICES=0.
NVIDIA_VISIBLE_DEVICES=all
CUDA_VISIBLE_DEVICES=0

# Operational VRAM budget for the VERITAS LLM service.
# Docker does not hard-partition GeForce VRAM. vLLM is constrained by
# VLLM_GPU_MEMORY_UTILIZATION. For a 48 GB card and a 30 GB LLM budget:
# 30 / 48 = 0.625, so 0.62 is a good starting point.
VERITAS_GPU_VRAM_BUDGET_GB=30
VLLM_GPU_MEMORY_UTILIZATION=0.62
VLLM_MAX_MODEL_LEN=65536

# Upload limits. Increase only after IT approves disk quota and reverse-proxy limits.
VERITAS_MAX_MEDIA_UPLOAD_BYTES=5368709120
VERITAS_MAX_CONTEXT_UPLOAD_BYTES=52428800

# LLM runtime.
# vllm profile starts the vLLM service inside Docker.
# To use Ollama instead, clear COMPOSE_PROFILES and set provider=ollama.
COMPOSE_PROFILES=vllm
EPAM_SUMMARIZATION_PROVIDER=openai_compatible
EPAM_SUMMARIZATION_OPENAI_BASE_URL=http://vllm:8000/v1
EPAM_SUMMARIZATION_OPENAI_API_KEY=
# VERITAS 1.0 backend uses this model-name field for both Ollama and vLLM.
EPAM_SUMMARIZATION_OLLAMA_MODEL=Qwen/Qwen3.6-27B

# Default vLLM model for the server pilot.
# IT can change this later in the Developer menu after the model is validated.
VLLM_IMAGE=vllm/vllm-openai:v0.18.2
VLLM_MODEL=Qwen/Qwen3.6-27B
VLLM_SERVED_MODEL_NAME=Qwen/Qwen3.6-27B
VLLM_TENSOR_PARALLEL_SIZE=1
VLLM_DTYPE=auto
VLLM_BIND=127.0.0.1
VLLM_PORT=8001

# Windows/local fallback only. Usually not used on the Ubuntu server.
EPAM_SUMMARIZATION_OLLAMA_BASE_URL=http://host.docker.internal:11434
# If provider=ollama, change EPAM_SUMMARIZATION_OLLAMA_MODEL to gemma4:26b.

# Quality policy: no silent quality-degrading fallback.
VERITAS_DISABLE_QUALITY_FALLBACKS=true

# EPAM VERITAS 1.0 - Environment Configuration Template
# Copy to .env and fill in your actual values
# SECURITY: Never commit .env to version control!

# ============================================================
# REQUIRED in production
# ============================================================

# JWT secret key (generate with: python3 -c "import secrets; print(secrets.token_urlsafe(64))")
EPAM_AUTH_SECRET_KEY=CHANGE_ME_generate_a_random_64_byte_key

# Encryption at rest key (generate with: python3 -c "import secrets; print(secrets.token_urlsafe(64))")
EPAM_ENCRYPTION_SECRET_KEY=CHANGE_ME_generate_a_random_64_byte_key

# ============================================================
# Model access
# ============================================================

# Hugging Face token for first-time downloads of pyannote and optional HF models.
# Get token from https://huggingface.co/settings/tokens
HF_TOKEN=

# ============================================================
# Security settings
# ============================================================

# CORS: comma-separated production origins (empty = use dev defaults)
# Example: https://veritas.internal.epam.com
# EPAM_SECURITY_CORS_PRODUCTION_ORIGINS=["https://veritas.internal.epam.com"]

# Audit logging
# EPAM_AUDIT_ENABLED=true
# EPAM_AUDIT_LOG_DIR=data/audit

# Encryption at rest
# EPAM_ENCRYPTION_ENABLED=true

# Cleanup settings
# EPAM_CLEANUP_AUTO_CLEANUP=true
# EPAM_CLEANUP_RETENTION_HOURS=720
# EPAM_CLEANUP_SECURE_DELETE=true

# ============================================================
# Auth settings
# ============================================================

# Token expiry in minutes (default: 480 = 8 hours)
# EPAM_AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=480

# Pre-hashed admin password (generate with: python3 -c "from passlib.context import CryptContext; print(CryptContext(schemes=['bcrypt']).hash('your_password'))")
# EPAM_AUTH_DEFAULT_PASSWORD_HASH=$2b$12$...

# ============================================================
# Optional server configuration
# ============================================================

# EPAM_SERVER_HOST=0.0.0.0
# EPAM_SERVER_PORT=8000
# EPAM_SERVER_WORKERS=1

# ============================================================
# Pipeline profile
# ============================================================

# Profile: auto (detect from speaker count), small (2-4), large (5+)
# EPAM_PIPELINE_PROFILE=auto
# EPAM_PIPELINE_LARGE_PROFILE_THRESHOLD=5

# ============================================================
# Optional ML configuration
# ============================================================

# ASR engine and model
# EPAM_ASR_ENGINE=auto
# EPAM_ASR_DEVICE=cuda:0
# EPAM_ASR_COMPUTE_TYPE=float16
# EPAM_ASR_BEAM_SIZE=5
# Whisper model: "large-v3" or HF repo like "bzikst/faster-whisper-large-v3-russian"
# EPAM_ASR_WHISPER_MODEL=large-v3
# EPAM_ASR_INITIAL_PROMPT=Protocolul soveshchaniya yuridicheskoy firmy EPAM.
# EPAM_ASR_CONDITION_ON_PREVIOUS_TEXT=false
# EPAM_ASR_NO_SPEECH_THRESHOLD=0.6
# EPAM_ASR_COMPRESSION_RATIO_THRESHOLD=2.4

# Diarization engine: pyannote is the production engine.
# SpeechBrain is intentionally not used in the quality pipeline.
# EPAM_DIARIZATION_ENGINE=pyannote
# EPAM_DIARIZATION_CLUSTERING=spectral
# EPAM_DIARIZATION_WINDOW_DURATION=1.0
# EPAM_DIARIZATION_STEP_DURATION=0.5

# Summarization (Ollama, default model: gemma4:26b)
# EPAM_SUMMARIZATION_OLLAMA_BASE_URL=http://localhost:11434
# EPAM_SUMMARIZATION_OLLAMA_MODEL=gemma4:26b
# EPAM_SUMMARIZATION_OLLAMA_TIMEOUT=300
# EPAM_SUMMARIZATION_OLLAMA_NUM_CTX=auto
# EPAM_SUMMARIZATION_OLLAMA_NUM_CTX_AUTO_MIN=65536
# EPAM_SUMMARIZATION_OLLAMA_NUM_CTX_AUTO_MAX=262144
# EPAM_SUMMARIZATION_MAX_NEW_TOKENS=8192
# EPAM_SUMMARIZATION_ADMIN_MAX_NEW_TOKENS=12288
# EPAM_SUMMARIZATION_STRUCTURED_OUTPUTS=true
# EPAM_SUMMARIZATION_CONTEXT_FILE_MAX_CHARS=20000
# EPAM_SUMMARIZATION_TEMPERATURE=0.1
# EPAM_SUMMARIZATION_TOP_P=0.80

# Cloud comparison is disabled by default because it sends transcript
# content outside the on-premise environment.
# EPAM_SECURITY_CLOUD_COMPARE_ENABLED=false

# EPAM_QUALITY_MIN_CONFIDENCE=0.6
